# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings > API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works (NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server only. The legacy "service_role" key also works (SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=

# --- OpenRouteService (server only; https://openrouteservice.org/dev/#/signup) ---
ORS_API_KEY=
# Optional: ISO 3166-1 alpha-2 country code(s) to focus address search, comma separated (e.g. NG or GB,IE)
ORS_GEOCODE_COUNTRY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: map tiles. Defaults to the public OpenStreetMap tile server (light use only).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
